    stepName: "\uC124\uBA85"
    stepType: 1
    dialoguePages:
    - "\uBD84\uC5F4\uCCB4, \uD3F0, \uBE44\uC20D, \uB098\uC774\uD2B8, \uB8E9\uC744
      \uBAA8\uB450 \uC0DD\uC131 \uD558\uC600\uC2B5\uB2C8\uB2E4."

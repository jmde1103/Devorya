    stepName: "\uBD84\uC5F4 \uC0AC\uC6A9 \uB300\uC0AC"
    stepType: 1
    dialoguePages:
    - "\uB2A5\uB825 [\uBD84\uC5F4]\uC744 \uC0AC\uC6A9\uD588\uC2B5\uB2C8\uB2E4.\n[\uBD84\uC5F4]
      \uC0AC\uC6A9\uC758 \uBC18\uB3D9\uC73C\uB85C \uC0C1\uD0DC \uD6A8\uACFC [\uACF5\uACA9\uBD88\uAC00]\uAC00
      \uC801\uC6A9\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    - "\uC0C1\uD0DC \uD6A8\uACFC\uB294 \uC2A4\uD14C\uC774\uD130\uC2A4\uC5D0\uC11C
      \uD655\uC778\uD560 \uC218 \uC788\uC73C\uBA70, \uC9C0\uC18D \uC2DC\uAC04\uC774
      \uC885\uB8CC\uB418\uBA74 \uC790\uB3D9\uC73C\uB85C \uD574\uC81C\uB429\uB2C8\uB2E4."
    - "\uB2A5\uB825\uC744 \uC0AC\uC6A9\uD574 \uC2DC\uAC04\uC744 \uBC88 \uD2C8\uC744
      \uD0C0, \uB370\uBCF4\uB9AC\uC544 [\uBE44\uC20D]\uC744 \uC774\uC6A9\uD558\uC5EC
      \uB0A8\uC740 \uC0C1\uB300 \uAC1C\uCCB4\uB97C \uC2E0\uC18D\uD558\uAC8C \uC81C\uC555\uD569\uB2C8\uB2E4."
    dialogueLocalizationId: dialogue_06824d7b
    dialogueLocalizationPages:

  - showTutorialInstruction: 1
    tutorialInstructionText: "\uD0C0\uC77C\uC744 \uC120\uD0DD\uD574 \uC8FC\uC138\uC694."
    tutorialInstructionLocalizationId: instruction_6e33437b
    tutorialInstructionLocalizedText:
      m_TableReference:
        m_TableCollectionName: GUID:6ac2f911a5b58f6408736734707d5412
      m_TableEntryReference:
        m_KeyId: 19181668481503232
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    stepName: "\uB370\uBCF4\uB9AC\uC544 \uD3F0 \uC774\uB3D9"
    stepType: 3
    dialoguePages:
    - "\uB300\uC0C1\uC758 \uC815\uBCF4\uB97C \uC2A4\uCE94 \uC644\uB8CC."
    - "\uC624\uB978\uCABD \uC0C1\uB2E8 \uC778\uD130\uD398\uC774\uC2A4\uC5D0 \uC2A4\uCE94\uD55C
      \uB300\uC0C1\uC758 \uD0C0\uC785, \uD2B9\uC131, \uC2A4\uD0AC \uB4F1 \uC815\uBCF4\uB97C
      \uD45C\uAE30\uD569\uB2C8\uB2E4."
    - "\uC778\uD130\uD398\uC774\uC2A4 \uB0B4 \uC544\uC774\uCF58\uC5D0 \uB300\uD55C
      \uC790\uC138\uD55C \uC124\uBA85 \uD655\uC778\uC740 \uB514\uBC14\uC774\uC2A4\uC758
      \uC720\uD615\uC5D0 \uB530\uB77C \uB2E4\uB974\uAC8C \uC5F4\uB78C \uAC00\uB2A5\uD569\uB2C8\uB2E4. "
    - "[\uBAA8\uBC14\uC77C]\n\uC544\uC774\uCF58\uC744 \uD130\uCE58 \uC911 \uC5F4\uB78C
      \uAC00\uB2A5\n[PC]\n\uB9C8\uC6B0\uC2A4 \uCEE4\uC11C\uB97C \uC544\uC774\uCF58
      \uC704\uC5D0 \uC62C\uB9AC\uBA74 \uC5F4\uB78C \uAC00\uB2A5 "
    - "\uC815\uBCF4\uB97C \uC2A4\uCE94\uD55C \uAC1C\uCCB4\uB97C \uD761\uC218 \uD569\uB2C8\uB2E4. "
    dialogueLocalizationId: dialogue_4185df61
    dialogueLocalizationPages: []

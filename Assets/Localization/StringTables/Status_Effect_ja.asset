  m_TableData:
  - m_Id: 722079744
    m_Localized: "\u9632\u5FA1"
    m_Metadata:
      m_Items: []
  - m_Id: 793382912
    m_Localized: "\u3053\u306E\u30BF\u30FC\u30F3\u3001\u76F8\u624B\u306E\u653B\u6483\u3092\u7121\u52B9\u5316\u3057\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 72098723270656
    m_Localized: "\u7A81\u7834"
    m_Metadata:
      m_Items: []
  - m_Id: 72098777796608
    m_Localized: "\u76F8\u624B\u306E\u4E00\u822C\u30B9\u30AD\u30EB\u300C\u9632\u5FA1\u300D\u3092\u7121\u8996\u3057\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 72943439319040
    m_Localized: "\u9000\u5316"
    m_Metadata:
      m_Items: []
  - m_Id: 72943439319041
    m_Localized: "退化状態の駒が倒されると、隣接する空きマスに同じ陣営のジェル [ポーン]を1体生成する。生成した駒は倒された駒の特性を引き継ぐ。"
    m_Metadata:
      m_Items: []
  - m_Id: 16559834879627264
    m_Localized: "\u653B\u6483\u4E0D\u53EF"
    m_Metadata:
      m_Items: []
  - m_Id: 16559834950930432
    m_Localized: "\uFF3B\u653B\u6483\u4E0D\u53EF\uFF3D\u72B6\u614B\u3067\u306F\u3001\u76F8\u624B\u306E\u99D2\u3092\u53D6\u308B\u79FB\u52D5\u306F\u3067\u304D\u307E\u305B\u3093\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 16700000000000001
    m_Localized: "挑発"
    m_Metadata:
      m_Items: []
  - m_Id: 16700000000000002
    m_Localized: "隣接する味方が攻撃されると、その駒と位置を入れ替わり、代わりに攻撃を受ける。"
    m_Metadata:
      m_Items: []
  - m_Id: 16720000000000001
    m_Localized: "回避"
    m_Metadata:
      m_Items: []
  - m_Id: 16720000000000002
    m_Localized: "攻撃されると、50%の確率で隣接する空きマスへ移動して攻撃を回避する。攻撃した駒は回避前のマスへ移動する。"
    m_Metadata:
      m_Items: []
  references:
    version: 2

    m_Metadata:
      m_Items: []
  - m_Id: 72943439319041
    m_Localized: "\uACF5\uACA9 \uB610\uB294 \uD761\uC218\uB85C \uC81C\uAC70\uB418\uBA74
      \uC778\uC811\uD55C \uBE48\uCE78\uC5D0 \uAC19\uC740 \uC9C4\uC601\uC758 \uC824\uB8E8
      [\uD3F0] 1\uAC1C\uB97C \uC0DD\uC131\uD558\uACE0 \uD2B9\uC131\uC744 \uACC4\uC2B9\uD569\uB2C8\uB2E4."

  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: EventScene_Dialogue_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 1d040faacacfa1248aff1aa7194ad8f0, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 734662656
    m_Localized: Hello.
    m_Metadata:
      m_Items: []
  - m_Id: 1453953120866304
    m_Localized: $!@$!$$
    m_Metadata:
      m_Items: []
  - m_Id: 12189788627668992
    m_Localized: You come across a pile of junk left behind by someone.
    m_Metadata:
      m_Items: []
  - m_Id: 12189788690583552
    m_Localized: Investigate the junk.
    m_Metadata:
      m_Items: []
  - m_Id: 12189788690583553
    m_Localized: Ignore it and move on.
    m_Metadata:
      m_Items: []
  - m_Id: 12328136805584896
    m_Localized: There might be something useful if you take a closer look.
    m_Metadata:
      m_Items: []
  - m_Id: 12347867402997760
    m_Localized: Found something useful!
    m_Metadata:
      m_Items: []
  - m_Id: 12359955819139072
    m_Localized: It appears to be selling something.
    m_Metadata:
      m_Items: []
  - m_Id: 12564537832771584
    m_Localized: Reboot complete... GPS system error... Signal anomaly. Communication
      with the laboratory has been lost.
    m_Metadata:
      m_Items: []
  - m_Id: 13485366015823872
    m_Localized: A high-output energy storage unit has been found offline.
    m_Metadata:
      m_Items: []
  - m_Id: 13485384391069696
    m_Localized: 'Synchronizing with the energy storage unit....

      Attempting
      reboot.'
    m_Metadata:
      m_Items: []
  - m_Id: 12348046927597569
    m_Localized: There might be something useful if you investigate it.
    m_Metadata:
      m_Items: []
  - m_Id: 12348046927597568
    m_Localized: You come across a pile of junk left behind by someone.
    m_Metadata:
      m_Items: []
  - m_Id: 12348046927597570
    m_Localized: Investigate the junk.
    m_Metadata:
      m_Items: []
  - m_Id: 12348046927597571
    m_Localized: Ignore it and move on.
    m_Metadata:
      m_Items: []
  - m_Id: 12348046927597572
    m_Localized: Found something useful!
    m_Metadata:
      m_Items: []
  - m_Id: 13494882459586560
    m_Localized: Absorbs the remaining energy from the high-output energy storage
      unit.
    m_Metadata:
      m_Items: []
  - m_Id: 13495016316604416
    m_Localized: '<size=130%>Repairs Devorya''s Fragments.</size>

      <size=80%>(Cannot
      repair beyond the maximum piece capacity of 10.)</size>'
    m_Metadata:
      m_Items: []
  - m_Id: 13495046221991936
    m_Localized: '<size=130%>Upgrades a Devorya Fragment.</size>

      <size=80%>(Randomly
      upgrades a Pawn into a Knight, Bishop, or Rook.)</size>'
    m_Metadata:
      m_Items: []
  - m_Id: 13510856315375616
    m_Localized: 'Repairs Devorya''s Fragments.

      (Cannot repair beyond the
      maximum piece capacity of 10.)'
    m_Metadata:
      m_Items: []
  - m_Id: 1453953196363776
    m_Localized: The screen shakes.
    m_Metadata:
      m_Items: []
  - m_Id: 12328324995616768
    m_Localized: '!@#$!@$!$!@$!'
    m_Metadata:
      m_Items: []
  - m_Id: 12361164965679104
    m_Localized: '!@#!$!@$!@$@~~~'
    m_Metadata:
      m_Items: []
  - m_Id: 13493486704267264
    m_Localized: By absorbing the energy remaining in the high-output energy storage
      unit,
    m_Metadata:
      m_Items: []
  - m_Id: 14177455842136064
    m_Localized: You can implement various features like these directly in the scene.
    m_Metadata:
      m_Items: []
  - m_Id: 14177483818143744
    m_Localized: Life signs detected nearby.
    m_Metadata:
      m_Items: []
  - m_Id: 14177483818143745
    m_Localized: '!@#!@$!!!!!!!!!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 15073048139534336
    m_Localized: "\uC720\uBB3C\uC744 \uBC1B\uC558\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 15489509534339072
    m_Localized: Threat response detected. Prepare for combat.
    m_Metadata:
      m_Items: []
  - m_Id: 15591513854185472
    m_Localized: 'No signs of nearby lifeforms detected.

      No additional threats
      are present.

      Disengaging alert mode.'
    m_Metadata:
      m_Items: []
  - m_Id: 15594546860265472
    m_Localized: 'Damaged function memory data has been detected during the assigned
      mission.

      Current Energy is sufficient to repair 1 data entry.

      Displaying
      the list of available data.'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []

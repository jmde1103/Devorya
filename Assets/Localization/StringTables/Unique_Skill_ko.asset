  m_TableData:
  - m_Id: 722079744
    m_Localized: "\uBFD4 \uBC15\uCE58\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 793382912
    m_Localized: "[\uBB3C] \uB610\uB294 [\uB2AA] \uD0C0\uC77C \uC704\uC5D0\uC11C
      \uC0AC\uC6A9\uD558\uBA74 \uC790\uC2E0\uC5D0\uAC8C [\uB3CC\uD30C]\uB97C 1\uD134
      \uB3D9\uC548 \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 1511529955060350982
  - m_Id: 793382913
    m_Localized: "\uC870\uAC74\uC774 \uB9DE\uC9C0 \uC54A\uC544 \uC0AC\uC6A9\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 84051071995904
    m_Localized: "\uBCF5\uC81C"
    m_Metadata:
      m_Items: []
  - m_Id: 84051134910464
    m_Localized: "\uC778\uC811\uD55C \uBE48\uCE78 \uC911 \uBB34\uC791\uC704 1\uCE78\uC5D0
      \uC790\uC2E0\uACFC \uAC19\uC740 \uC815\uBCF4\uB97C \uAC00\uC9C4 \uAE30\uBB3C\uC744
      \uBCF5\uC81C\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 1511529955060350983
  - m_Id: 84051134910465
    m_Localized: "\uC870\uAC74\uC774 \uB9DE\uC9C0 \uC54A\uC544 \uC0AC\uC6A9\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 85345065111552
    m_Localized: "\uD1F4\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 85345065111553
    m_Localized: "\uC790\uC2E0\uC5D0\uAC8C [\uD1F4\uD654]\uB97C 1\uD134 \uB3D9\uC548
      \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 1511529955060350984
  - m_Id: 85345065111554
    m_Localized: "\uC870\uAC74\uC774 \uB9DE\uC9C0 \uC54A\uC544 \uC0AC\uC6A9\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 85520307326976
    m_Localized: "\uC99D\uC2DD"
    m_Metadata:
      m_Items: []
  - m_Id: 85520307326977
    m_Localized: "\uC778\uC811\uD55C \uBE48\uCE78 \uC911 \uBB34\uC791\uC704 1\uCE78\uC5D0
      \uAC19\uC740 \uC885\uC871\uC758 [\uD3F0] 1\uAC1C\uB97C \uC0DD\uC131\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 1511529955060350985
  - m_Id: 85520307326978
    m_Localized: "\uC870\uAC74\uC774 \uB9DE\uC9C0 \uC54A\uC544 \uC0AC\uC6A9\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 86056217743360
    m_Localized: "\uD569\uC131"
    m_Metadata:
      m_Items: []
  - m_Id: 86056217743361
    m_Localized: "\uC778\uC811\uD55C \uC544\uAD70 \uC911 \uC790\uC2E0\uACFC \uAC19\uC740
      \uC885\uB958\uC758 \uAE30\uBB3C 2\uAC1C\uC640 \uD569\uC131\uD558\uC5EC, \uC790\uC2E0\uC758
      \uC885\uC871\uC744 \uC720\uC9C0\uD55C \uCC44 [\uB098\uC774\uD2B8], [\uBE44\uC20D],
      [\uB8E9] \uC911 \uD558\uB098\uB85C \uBB34\uC791\uC704 \uC2B9\uAE09\uD569\uB2C8\uB2E4.
      \uC790\uC2E0\uC5D0\uAC8C [\uACF5\uACA9\uBD88\uAC00]\uB97C 1\uD134 \uB3D9\uC548
      \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 1511529955060350986
  - m_Id: 86056217743362
    m_Localized: "\uC778\uC811\uD55C \uC544\uAD70 \uC911 \uC790\uC2E0\uACFC \uAC19\uC740
      \uC885\uB958\uC758 \uAE30\uBB3C\uC774 2\uAC1C \uD544\uC694\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 88327840206848
    m_Localized: "\uC824\uB8E8 \uBCBD"
    m_Metadata:
      m_Items: []
  - m_Id: 88327840206849
    m_Localized: "\uC790\uC2E0\uC758 \uC55E \uCE78\uC5D0 \uC911\uB9BD \uAE30\uBB3C
      [\uC824\uB8E8 \uBCBD] 1\uAC1C\uB97C \uC0DD\uC131\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 1511529955060350987
  - m_Id: 88327840206850
    m_Localized: "\uC870\uAC74\uC774 \uB9DE\uC9C0 \uC54A\uC544 \uC0AC\uC6A9\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 88777704476672
    m_Localized: "\uC655\uC758 \uAC01\uC131"
    m_Metadata:
      m_Items: []
  - m_Id: 88777704476673
    m_Localized: "\uC544\uAD70 \uAE30\uBB3C\uC774 3\uAC1C \uCC98\uCE58\uB420 \uB54C\uB9C8\uB2E4
      \uD574\uB2F9 \uD134 \uB3D9\uC548 [\uD038]\uCC98\uB7FC \uC774\uB3D9\uD558\uACE0
      \uACF5\uACA9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 1511529955060350988
  - m_Id: 88777704476674
    m_Localized: "\uC870\uAC74\uC774 \uB9DE\uC9C0 \uC54A\uC544 \uC0AC\uC6A9\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 16691838908502016
    m_Localized: "\uBD84\uC5F4"
    m_Metadata:
      m_Items: []
  - m_Id: 16691838979805184
    m_Localized: "\uC790\uC2E0\uC744 \uC81C\uAC70\uD558\uACE0, \uC6D0\uB798 \uC704\uCE58\uC640
      \uC778\uC811\uD55C \uBE48\uCE78\uC5D0 \uC824\uB8E8 [\uD3F0]\uC744 \uAC01\uAC01
      1\uAC1C\uC529 \uC0DD\uC131\uD569\uB2C8\uB2E4. \uC0DD\uC131\uB41C \uAE30\uBB3C\uC740
      \uC790\uC2E0\uC758 \uD2B9\uC131\uC744 \uC774\uC5B4\uBC1B\uC73C\uBA70, [\uACF5\uACA9\uBD88\uAC00]\uB97C
      1\uD134 \uB3D9\uC548 \uBD80\uC5EC\uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 1511529955060350989
  - m_Id: 16691838979805185
    m_Localized: "\uCD5C\uB300 \uAE30\uBB3C \uC218\uB97C \uCD08\uACFC\uD558\uAC8C
      \uB418\uC5B4 \uBD84\uC5F4\uC744 \uC0AC\uC6A9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 16691840000000001
    m_Localized: "\uD569\uC131: \uAC15\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 16691840000000002
    m_Localized: "\uC778\uC811\uD55C \uC544\uAD70 [\uD3F0] 1\uAC1C\uB97C \uBB34\uC791\uC704\uB85C
      \uD761\uC218\uD558\uACE0 \uC81C\uAC70\uD569\uB2C8\uB2E4. \uC790\uC2E0\uC5D0\uAC8C
      [\uB3CC\uD30C]\uC640 [\uBC29\uC5B4]\uB97C \uAC01\uAC01 1\uD134 \uB3D9\uC548
      \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 1511529955060350990
  - m_Id: 16691840000000003
    m_Localized: "\uD761\uC218\uD560 \uC218 \uC788\uB294 \uC778\uC811\uD55C \uC544\uAD70
      [\uD3F0]\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 18842575679655936
    m_Localized: "\uBC29\uC5B4\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 18842575750959104
    m_Localized: "\uC790\uC2E0\uC5D0\uAC8C [\uBC29\uC5B4]\uB97C \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 1511529994958405632
  - m_Id: 18842575755153408
    m_Localized: "\uC870\uAC74\uC774 \uB9DE\uC9C0 \uC54A\uC544 \uC0AC\uC6A9\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 18842576178778112
    m_Localized: "\uACF5\uAC04\uC774\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 18842576178778113
    m_Localized: "\uC790\uC2E0\uC5D0\uAC8C [\uACF5\uAC04\uC774\uB3D9]\uC744 \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 1511529994958405633
  - m_Id: 18842576178778114
    m_Localized: "\uC870\uAC74\uC774 \uB9DE\uC9C0 \uC54A\uC544 \uC0AC\uC6A9\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 18842576497545216
    m_Localized: "\uBC14\uC774\uB7EC\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 18842576497545217
    m_Localized: "\uC0C1\uB300 \uAE30\uBB3C \uC911 \uCD5C\uB300 3\uAC1C\uB97C \uBB34\uC791\uC704\uB85C
      \uC120\uD0DD\uD558\uC5EC \uAC01 \uAE30\uBB3C\uC5D0 [\uACF5\uACA9\uBD88\uAC00]
      \uB610\uB294 [\uC774\uB3D9\uBD88\uAC00] \uC911 \uD558\uB098\uB97C \uBB34\uC791\uC704\uB85C
      \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 1511529994958405634
  - m_Id: 18842576497545218
    m_Localized: "\uD6A8\uACFC\uB97C \uBD80\uC5EC\uD560 \uC0C1\uB300 \uAE30\uBB3C\uC774
      \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 18842576791146496
    m_Localized: "\uD68C\uD53C\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 18842576791146497
    m_Localized: "\uC790\uC2E0\uC5D0\uAC8C [\uD68C\uD53C]\uB97C \uBD80\uC5EC\uD569\uB2C8\uB2E4."

  m_TableData:
  - m_Id: 688525312
    m_Localized: "\uC0DD\uBA85\uCCB4 \uBC18\uC751 \uBC0F \uC774\uC0C1 \uBC18\uC751\uC744
      \uD3EC\uD568\uD55C \uC8FC\uBCC0 \uD658\uACBD\uC744 \uD0D0\uC0C9\uD574 \uC9C0\uB3C4\uC5D0
      \uD45C\uAE30\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 743051264
    m_Localized: "\uBCF4\uC548 \uB370\uC774\uD130 \u25A0\u25A0\u25A0\u25A0\u25A0\uC5D0\uC11C
      [\uC5D4\uB4DC\uD0C0\uC784]\uC744 \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 514058752000
    m_Localized: "[\uC5D4\uB4DC\uD0C0\uC784]\uC740 \uCD5C\uC6B0\uC120 \uB4F1\uAE09
      \uC815\uBCF4\uB85C \uBD84\uB958\uB418\uC5B4 \uD654\uBA74 \uC0C1\uB2E8\uC5D0
      \uD45C\uC2DC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 653557108736
    m_Localized: "\u25A0\u25A0\u25A0\u25A0\u25A0\uC758 \uC885\uB8CC\uAE4C\uC9C0 \uB0A8\uC740
      \uC2DC\uAC04\uC73C\uB85C \uAE30\uB85D\uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4.\n\uAD00\uB828
      \uB370\uC774\uD130\uAC00 \uC190\uC0C1\uB418\uC5B4 \uC0C1\uC138 \uC815\uBCF4\uB294
      \uD655\uC778\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1882102304768
    m_Localized: "\uBCF4\uC548 \uB370\uC774\uD130 \u25A0\u25A0\u25A0\u25A0\u25A0\uC5D0\uC11C
      [\uC5D4\uB4DC\uD0C0\uC784]\uC744 \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4.\n[\uC5D4\uB4DC\uD0C0\uC784]\uC740
      \uCD5C\uC6B0\uC120 \uB4F1\uAE09 \uC815\uBCF4\uB85C \uBD84\uB958\uB418\uC5B4
      \uD654\uBA74 \uC0C1\uB2E8\uC5D0 \uD45C\uC2DC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1882102304769
    m_Localized: "\u25A0\u25A0\u25A0\u25A0\u25A0\uC758 \uC885\uB8CC\uAE4C\uC9C0 \uB0A8\uC740
      \uC2DC\uAC04\uC73C\uB85C \uAE30\uB85D\uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4.\n\uAD00\uB828
      \uB370\uC774\uD130\uAC00 \uC190\uC0C1\uB418\uC5B4 \uC0C1\uC138 \uC815\uBCF4\uB294
      \uD655\uC778\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1882102304770
    m_Localized: "\uC785\uB825\uB41C \uCD5C\uC6B0\uC120 \uC784\uBB34\uB97C \uD655\uC778\uD569\uB2C8\uB2E4.\n\uC0DD\uBA85\uCCB4\uB97C
      \uD761\uC218\uD558\uC5EC \uB370\uC774\uD130\uB97C \uD655\uBCF4\uD569\uB2C8\uB2E4.\n\uC784\uBB34
      \uC218\uD589\uC744 \uAC1C\uC2DC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []

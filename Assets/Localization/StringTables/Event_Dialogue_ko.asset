--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Event_Dialogue_ko
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: 6ac2f911a5b58f6408736734707d5412, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 747245568
    m_Localized: "\uB370\uBCF4\uB9AC\uC544\uC758 \uAC00\uB3D9\uC744 \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4.
      \uAE30\uBCF8 \uAE30\uB2A5 \uD14C\uC2A4\uD2B8\uB97C \uC2DC\uC791\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 784994304
    m_Localized: "\uB370\uBCF4\uB9AC\uC544 \uBD84\uC5F4 \uAE30\uB2A5 \uD14C\uC2A4\uD2B8\uB97C
      \uC2DC\uC791\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 805965824
    m_Localized: "\uB370\uBCF4\uB9AC\uC544\uB294 \uB124 \uAC00\uC9C0 \uD615\uD0DC\uC758
      \uBD84\uC5F4\uCCB4\uB97C \uC0DD\uC131\uD558\uC5EC \uAC01\uAC01 \uB2E4\uB978
      \uC5ED\uD560\uC744 \uC218\uD589\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 805965825
    m_Localized: "\uAC01 \uBD84\uC5F4\uCCB4\uC758 \uBA85\uCE6D\uC740 \uD3F0, \uB8E9,
      \uB098\uC774\uD2B8, \uBE44\uC20D\uC785\uB2C8\uB2E4.\n\uAC01 \uAE30\uBB3C\uC740
      \uC11C\uB85C \uB2E4\uB978 \uBC29\uC2DD\uC73C\uB85C \uC774\uB3D9\uD558\uACE0
      \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 805965826
    m_Localized: "\uD3F0 \uAE30\uBB3C\uC744 \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 805965827
    m_Localized: "\uD3F0\uC740 \uC790\uC2E0\uC758 \uC9C4\uD589 \uBC29\uD5A5\uC73C\uB85C
      1\uCE78 \uC774\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 805965828
    m_Localized: "\uB8E9 \uAE30\uBB3C\uC744 \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 805965829
    m_Localized: "\uB8E9\uC740 \uC0C1\uD558\uC88C\uC6B0 \uC9C1\uC120 \uBC29\uD5A5\uC73C\uB85C
      \uC774\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 805965830
    m_Localized: "\uB098\uC774\uD2B8 \uAE30\uBB3C\uC744 \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 805965831
    m_Localized: "\uB098\uC774\uD2B8\uB294 \uB2E4\uB978 \uAE30\uBB3C\uC744 \uB6F0\uC5B4\uB118\uC5B4
      \uC774\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 805965832
    m_Localized: "\uBE44\uC20D \uAE30\uBB3C\uC744 \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 805965833
    m_Localized: "\uBE44\uC20D\uC740 \uB300\uAC01\uC120 \uBC29\uD5A5\uC73C\uB85C
      \uC774\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 805965834
    m_Localized: "\uB2E4\uC2DC \uD3F0 \uAE30\uBB3C\uC744 \uC120\uD0DD\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 805965835
    m_Localized: "\uD3F0\uC740 \uC9C4\uD589 \uBC29\uD5A5\uC758 \uB300\uAC01\uC120
      1\uCE78\uC5D0 \uC704\uCE58\uD55C \uB300\uC0C1\uC744 \uACF5\uACA9\uD558\uC5EC
      \uD761\uC218\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 805965836
    m_Localized: "\uD761\uC218 \uAC00\uB2A5\uD55C \uB300\uC0C1\uC5D0\uB294 \uD761\uC218
      \uC544\uC774\uCF58\uC774 \uD45C\uC2DC\uB429\uB2C8\uB2E4.\n\uC544\uC774\uCF58\uC744
      \uC120\uD0DD\uD558\uBA74 \uD761\uC218\uB97C \uC900\uBE44\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 805965837
    m_Localized: "\uB300\uC0C1\uC758 \uB370\uC774\uD130\uB97C \uC131\uACF5\uC801\uC73C\uB85C
      \uD761\uC218\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 805965838
    m_Localized: "\uB370\uBCF4\uB9AC\uC544\uB294 \uD761\uC218\uD55C \uC0DD\uBA85\uCCB4\uC758
      \uB370\uC774\uD130\uB97C \uC800\uC7A5\uD558\uACE0, \uADF8 \uB370\uC774\uD130\uB97C
      \uAE30\uBC18\uC73C\uB85C \uC790\uC2E0\uC758 \uBD84\uC5F4\uCCB4\uB97C \uBCC0\uD615\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 805965839
    m_Localized: "\uB610\uD55C \uD761\uC218\uD55C \uC0DD\uBA85\uCCB4\uAC00 \uC9C0\uB2CC
      \uD2B9\uC131\uACFC \uB2A5\uB825\uC744 \uC7AC\uD604\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 805965840
    m_Localized: "\uB8E9\uC744 \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 805965841
    m_Localized: "\uB8E9\uC740 \uC9C1\uC120\uC0C1\uC5D0 \uC704\uCE58\uD55C \uB300\uC0C1\uC744
      \uACF5\uACA9\uD558\uAC70\uB098 \uD761\uC218\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 805965842
    m_Localized: "\uC801\uC744 \uD761\uC218\uD574 \uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 805965843
    m_Localized: "\uB098\uC774\uD2B8\uB97C \uC120\uD0DD\uD558\uC138\uC694. "
    m_Metadata:
      m_Items: []
  - m_Id: 805965844
    m_Localized: "\uB098\uC774\uD2B8\uB294 \uB2E4\uB978 \uAE30\uBB3C\uC744 \uB6F0\uC5B4\uB118\uC5B4
      \uB300\uC0C1\uC744 \uACF5\uACA9\uD558\uAC70\uB098 \uD761\uC218\uD560 \uC218
      \uC788\uC2B5\uB2C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 805965845
    m_Localized: "\uC801 \uAE30\uBB3C\uC744 \uD761\uC218\uD574 \uBCF4\uC138\uC694. "
    m_Metadata:
      m_Items: []
  - m_Id: 805965846
    m_Localized: "\uBE44\uC20D\uC744 \uC120\uD0DD\uD558\uC138\uC694. "
    m_Metadata:
      m_Items: []
  - m_Id: 805965847
    m_Localized: "\uBE44\uC20D\uC740 \uB300\uAC01\uC120\uC0C1\uC5D0 \uC704\uCE58\uD55C
      \uB300\uC0C1\uC744 \uACF5\uACA9\uAC70\uB098 \uD761\uC218\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 805965848
    m_Localized: "\uC774\uBC88\uC5D4 \uD761\uC218 \uC5C6\uC774 \uC801\uC744 \uC120\uD0DD\uD574
      \uACF5\uACA9\uD569\uB2C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 805965849
    m_Localized: "\uD761\uC218 \uD558\uC9C0 \uC54A\uC73C\uBA74 \uBCC0\uD615\uD558\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 805965850
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uD14C\uC2A4\uD2B8\uB294 \uC2B9\uB9AC \uC870\uAC74
      \uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 805965851
    m_Localized: "\uC0C1\uB300\uC758 \uC6B0\uB450\uBA38\uB9AC\uC778 \uD0B9\uC744
      \uC81C\uAC70\uD558\uAC70\uB098, \uC0C1\uB300\uC758 \uBAA8\uB4E0 \uAE30\uBB3C\uC744
      \uC81C\uAC70\uD558\uBA74 \uC804\uD22C\uC5D0\uC11C \uC2B9\uB9AC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 805965852
    m_Localized: "\uD0B9\uC744 \uC9C1\uC811 \uACF5\uACA9\uD558\uC5EC \uD761\uC218\uD560
      \uC218 \uC788\uB294 \uAE30\uBB3C\uC740 \uAC19\uC740 \uD0B9\uBFD0\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 805965853
    m_Localized: "\uC801 \uD0B9\uC744 \uD761\uC218\uD574 \uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 805965854
    m_Localized: "\uC804\uD22C \uC911 \uD761\uC218\uD55C \uC0C1\uB300 \uC0DD\uBA85\uCCB4
      \uC218\uC758 \uC808\uBC18\uB9CC\uD07C \uB370\uBCF4\uB9AC\uC544\uC758 \uAE30\uBB3C\uC774
      \uBCF5\uAD6C\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 805965855
    m_Localized: "\uB2E8, \uBCF4\uC720 \uAC00\uB2A5\uD55C \uCD5C\uB300 \uAE30\uBB3C
      \uC218\uC778 10\uAC1C\uB97C \uCD08\uACFC\uD558\uC5EC \uBCF5\uAD6C\uD560 \uC218\uB294
      \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 805965856
    m_Localized: "\uAE30\uBCF8 \uAE30\uB2A5 \uD14C\uC2A4\uD2B8\uAC00 \uC644\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 805965857
    m_Localized: "\uB2E4\uC74C \uD14C\uC2A4\uD2B8\uB97C\u2026\u2026 \uC2DC\u2026\u2026\uC791\u2026\u2026
      \uD558\uACA0\u2026\u2026\uC2B5\u2026\u2026 \uB2C8\u2026\u2026 \u2026\u2026
      \uC9C0\uC9C0\uC9C1\u2026\u2026 \uAE30\u2026\u2026\uBCF8\u2026\u2026 \uD14C\uC2A4\u2026\u2026\uD2B8\u2026\u2026
      \uC774\u2026\u2026\uC81C\u2026\u2026 \uC774\u2026\u2026\uC81C\u2026\u2026\u3148\u2026\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 23825027305472
    m_Localized: "\uD604\uC7AC \uC9C0\uC5ED\uC5D0 \uB2E4\uC218\uC758 \uC0DD\uBA85\uCCB4
      \uBC18\uC751 \uD655\uC778."
    m_Metadata:
      m_Items: []
  - m_Id: 23825027305473
    m_Localized: "\uC785\uB825\uB41C \uC784\uBB34\uB97C \uAC15\uC81C \uC2E4\uD589
      \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499776
    m_Localized: "\uD6A8\uC728\uC801\uC778 \uC784\uBB34 \uC218\uD589\uC744 \uC704\uD574
      \uBD84\uC5F4\uCCB4\uB97C \uC0DD\uC131\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499777
    m_Localized: "\uBD84\uC5F4\uCCB4, \uD3F0, \uBE44\uC20D, \uB098\uC774\uD2B8, \uB8E9\uC744
      \uBAA8\uB450 \uC0DD\uC131 \uD558\uC600\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499778
    m_Localized: "\uC8FC\uBCC0 \uC0DD\uBA85\uCCB4\uC758 \uAE30\uBCF8 \uC815\uBCF4\uB97C
      \uC2A4\uCE94\uC911..."
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499779
    m_Localized: "\uC778\uD130\uD398\uC774\uC2A4 \uD654\uBA74\uC5D0 \uC815\uBCF4
      \uBCF4\uAE30 [ i ] \uC120\uD0DD\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499780
    m_Localized: "\uC0DD\uBA85\uCCB4\uC758 \uD0C0\uC785\uC744 \uD655\uC778 \uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499781
    m_Localized: "\uC815\uBCF4 \uBCF4\uAE30 [ i ]\uC744 \uC5EC\uB7EC\uBC88 \uC120\uD0DD\uD558\uBA74 
      \uC8FC\uBCC0 \uC0DD\uBA85\uCCB4\uC758 \uD0C0\uC785\uC774 \uD45C\uC2DC\uB418\uB294
      \uC815\uBCF4\uB97C \uC870\uC815 \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499782
    m_Localized: "\uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC0DD\uBA85\uCCB4\uB97C \uC2A4\uCE94\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499783
    m_Localized: "\uB300\uC0C1\uC758 \uC815\uBCF4\uB97C \uC2A4\uCE94 \uC644\uB8CC."
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499784
    m_Localized: "\uC624\uB978\uCABD \uC0C1\uB2E8 \uC778\uD130\uD398\uC774\uC2A4\uC5D0
      \uC2A4\uCE94\uD55C \uB300\uC0C1\uC758 \uD0C0\uC785, \uD2B9\uC131, \uC2A4\uD0AC
      \uB4F1 \uC815\uBCF4\uB97C \uD45C\uAE30\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499785
    m_Localized: "\uC778\uD130\uD398\uC774\uC2A4 \uB0B4 \uC544\uC774\uCF58\uC5D0
      \uB300\uD55C \uC790\uC138\uD55C \uC124\uBA85 \uD655\uC778\uC740 \uB514\uBC14\uC774\uC2A4\uC758
      \uC720\uD615\uC5D0 \uB530\uB77C \uB2E4\uB974\uAC8C \uC5F4\uB78C \uAC00\uB2A5\uD569\uB2C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499786
    m_Localized: "[\uBAA8\uBC14\uC77C]\n\uC544\uC774\uCF58\uC744 \uD130\uCE58 \uC911
      \uC5F4\uB78C \uAC00\uB2A5\n[PC]\n\uB9C8\uC6B0\uC2A4 \uCEE4\uC11C\uB97C \uC544\uC774\uCF58
      \uC704\uC5D0 \uC62C\uB9AC\uBA74 \uC5F4\uB78C \uAC00\uB2A5 "
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499787
    m_Localized: "\uC815\uBCF4\uB97C \uC2A4\uCE94\uD55C \uAC1C\uCCB4\uB97C \uD761\uC218
      \uD569\uB2C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499788
    m_Localized: "\uD761\uC218\uD55C \uC0C1\uB300\uC758 \uD2B9\uC131, \uB2A5\uB825,
      \uD0C0\uC785, \uD615\uD0DC\uC758 \uC815\uBCF4\uB97C \uB370\uC774\uD130\uBCA0\uC774\uC2A4\uC5D0
      \uC800\uC7A5 "
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499789
    m_Localized: "\uD761\uC218\uD55C \uC0C1\uB300\uC758 \uC815\uBCF4\uB97C \uBC14\uD0D5\uC73C\uB85C
      \uD3F0\uC744 \uC7AC\uAD6C\uC131 \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499790
    m_Localized: "\uC7AC\uAD6C\uC131\uB41C \uD3F0\uC758 \uC815\uBCF4\uB97C \uD655\uC778
      \uD569\uB2C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499791
    m_Localized: "\uC544\uAD70\uC758 \uC2A4\uD14C\uC774\uD130\uC2A4 \uC815\uBCF4\uB294
      \uC67C\uCABD \uD558\uB2E8 \uC778\uD130\uD398\uC774\uC2A4\uC5D0 \uD45C\uAE30\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499792
    m_Localized: "\uBAA9\uD45C\uBB3C\uC774 \uB2A5\uB825\uC744 \uC0AC\uC6A9\uD569\uB2C8\uB2E4.
      \n\uC0C1\uB300 \uBC18\uC751\uC5D0 \uB300\uD55C \uBD84\uC11D \uC911.... \uBD84\uC11D
      \uC644\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499793
    m_Localized: "\uACF5\uD3EC, \uBD88\uC548 \uB4F1 \uACF5\uACA9\uC801\uC778 \uC131\uD5A5\uC774
      \uB098\uD0C0\uB0A9\uB2C8\uB2E4.\n\uBA58\uD0C8\uCF00\uC5B4 \uD504\uB85C\uD1A0\uCF5C
      \uC2E4\uD589"
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499794
    m_Localized: "\"\uC548\uC2EC\uD558\uC2ED\uC2DC\uC624 \uC5B4\uB5A0\uD55C \uD1B5\uC99D\uB3C4
      \uACE0\uD1B5\uB3C4 \uC5C6\uC2B5\uB2C8\uB2E4. \uC27D\uACE0 \uBE60\uB978 \uD761\uC218!\" "
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499795
    m_Localized: "\uB300\uC0C1\uC758 \uACF5\uD3EC \uC218\uCE58\uAC00 \uD55C\uACC4\uCE58
      \uCD08\uACFC \uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499796
    m_Localized: "\uC0C1\uB300\uC758 \uBE44\uC20D \uD0C0\uC785 \uC0DD\uBA85\uCCB4\uAC00
      \uC0DD\uBA85 \uBC18\uC751\uC774 \uC5C6\uB294 \uC911\uB9BD \uAE30\uBB3C\uC744
      \uC0DD\uC131\uD55C \uAC83\uC73C\uB85C \uD655\uC778\uC774 \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499797
    m_Localized: "\uC6B0\uC120 \uBAA9\uD45C\uBB3C\uC774 \uB3C4\uB9DD\uAC00\uAE30
      \uC804\uC5D0 \uC2E0\uC18D\uD55C \uD761\uC218\uB97C \uC9C4\uD589\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499798
    m_Localized: "\uB098\uC774\uD2B8\uB97C \uC774\uC6A9\uD558\uC5EC \uC0C1\uB300
      \uB97C \uD761\uC218 \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499799
    m_Localized: "\uBAA9\uD45C\uBB3C \uBE44\uC20D \uD0C0\uC785 \uC0DD\uBA85\uCCB4
      \uD761\uC218 \uC644\uB8CC \uD761\uC218\uD55C \uC0DD\uBA85\uCCB4\uB85C \uC7AC\uAD6C\uC131
      \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499800
    m_Localized: "\uD761\uC218 \uD6A8\uC728\uC744 \uB192\uC774\uAE30 \uC704\uD55C
      \uC804\uB7B5 \uBD84\uC11D\uC5D0 \uB4E4\uC5B4\uAC11\uB2C8\uB2E4....\uBD84\uC11D
      \uC644\uB8CC \uAC00\uC7A5 \uC774\uC0C1 \uC801 \uD761\uC218 \uB8E8\uD2B8 \uD655\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499801
    m_Localized: "\uC7AC\uAD6C\uC131\uB41C \uBE44\uC20D\uC758 \uB2A5\uB825\uC744
      \uC0AC\uC6A9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499802
    m_Localized: "\uC0DD\uC131\uB41C \uC911\uB9BD \uAE30\uBB3C\uC740 \uC6C0\uC9C1\uC774\uC9C0
      \uC54A\uC73C\uBA70 \uB204\uAD6C\uC758 \uC18C\uC18D\uB3C4 \uC544\uB2CC \uBB34\uC0DD\uBB3C
      \uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499803
    m_Localized: "\uC5B4\uB5A4 \uC18C\uC18D\uC774\uB358 \uACF5\uACA9\uD558\uC5EC
      \uC774\uB3D9 \uBC0F \uACF5\uACA9 \uC81C\uAC70\uAC00 \uAC00\uB2A5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499804
    m_Localized: "\uACF5\uACA9\uD558\uC5EC \uC911\uB9BD \uAE30\uBB3C\uC744 \uC81C\uAC70\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499805
    m_Localized: "\uC911\uB9BD \uAE30\uBB3C\uC744 \uC774\uC6A9\uD558\uC5EC \uD3F0\uC744
      \uB300\uAC01\uC120 \uC774\uB3D9 \uD6C4 \uB450\uAC00\uC9C0 \uD0C0\uAC9F\uC744
      \uB3D9\uC2DC\uC5D0 \uACAC\uC81C\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499806
    m_Localized: "\uD3F0\uC744 \uC120\uD0DD\uD558\uC5EC \uC0C1\uB300\uC758 \uB098\uC774\uD2B8
      \uD0C0\uC785 \uC0DD\uBA85\uCCB4\uB97C \uD761\uC218\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499807
    m_Localized: "\uD761\uC218\uD55C \uC0DD\uBA85\uCCB4\uB85C \uB2E4\uC2DC \uC7AC\uAD6C\uC131
      \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499808
    m_Localized: "\uC0C1\uB300\uC758 \uAC1C\uCCB4\uAC00 1\uB9C8\uB9AC \uB0A8\uC73C\uBA74
      \uD0B9\uC744 \uC774\uC6A9\uD574 '\uB9C8\uBB34\uB9AC \uC77C\uACA9'\uC744 \uC0AC\uC6A9\uD574
      \uC27D\uAC8C \uD761\uC218\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499809
    m_Localized: "\uC8FC\uBCC0 \uD658\uACBD \uAC10\uC9C0\uB41C \uC0DD\uBA85\uBC18\uC751
      \uC5C6\uC74C "
    m_Metadata:
      m_Items: []
  - m_Id: 23825031499810
    m_Localized: "\uB2E4\uC74C \uC7A5\uC18C\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4. "
    m_Metadata:
      m_Items: []
  references:
    version: 2

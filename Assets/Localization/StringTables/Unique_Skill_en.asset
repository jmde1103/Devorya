  m_TableData:
  - m_Id: 722079744
    m_Localized: Horn Charge
    m_Metadata:
      m_Items: []
  - m_Id: 793382912
    m_Localized: When used on a 'Water' or 'Swamp' tile, gain 'Breakthrough' for
      1 turn.
    m_Metadata:
      m_Items: []
  - m_Id: 793382913
    m_Localized: The conditions are not met, so this skill cannot be used.
    m_Metadata:
      m_Items: []
  - m_Id: 84051071995904
    m_Localized: Clone
    m_Metadata:
      m_Items: []
  - m_Id: 84051134910464
    m_Localized: Creates a duplicate piece with the same data as itself on 1 random
      adjacent empty tile.
    m_Metadata:
      m_Items: []
  - m_Id: 84051134910465
    m_Localized: The conditions are not met, so this skill cannot be used.
    m_Metadata:
      m_Items: []
  - m_Id: 85345065111552
    m_Localized: Degeneration
    m_Metadata:
      m_Items: []
  - m_Id: 85345065111553
    m_Localized: Grants itself the 'Degeneration' status effect for 1 turn.
    m_Metadata:
      m_Items: []
  - m_Id: 85345065111554
    m_Localized: The conditions are not met, so this skill cannot be used.
    m_Metadata:
      m_Items: []
  - m_Id: 85520307326976
    m_Localized: Multiply
    m_Metadata:
      m_Items: []
  - m_Id: 85520307326977
    m_Localized: Creates a Pawn of the same race on 1 random adjacent tile.
    m_Metadata:
      m_Items: []
  - m_Id: 85520307326978
    m_Localized: The conditions are not met, so this skill cannot be used.
    m_Metadata:
      m_Items: []
  - m_Id: 86056217743360
    m_Localized: "Synthesis"
    m_Metadata:
      m_Items: []
  - m_Id: 86056217743361
    m_Localized: "Fuse with two adjacent allies of the same piece type as yourself to promote randomly into a Knight, Bishop, or Rook of your species. Gain [Attack Disabled] for 1 turn."
    m_Metadata:
      m_Items: []
  - m_Id: 86056217743362
    m_Localized: "Requires two adjacent allies of the same piece type as yourself."
    m_Metadata:
      m_Items: []
  - m_Id: 88327840206848
    m_Localized: Jellu Wall
    m_Metadata:
      m_Items: []
  - m_Id: 88327840206849
    m_Localized: Creates 1 neutral 'Jellu Wall' piece in front of itself.
    m_Metadata:
      m_Items: []
  - m_Id: 88327840206850
    m_Localized: The conditions are not met, so this skill cannot be used.
    m_Metadata:
      m_Items: []
  - m_Id: 88777704476672
    m_Localized: King's Awakening
    m_Metadata:
      m_Items: []
  - m_Id: 88777704476673
    m_Localized: Every time 3 allied pieces are captured, moves and attacks like
      a Queen for the rest of this turn.
    m_Metadata:
      m_Items: []
  - m_Id: 88777704476674
    m_Localized: "The conditions are not met, so this skill cannot be used.\u738B\u306E\u899A\u9192"
    m_Metadata:
      m_Items: []
  - m_Id: 16691838908502016
    m_Localized: Split
    m_Metadata:
      m_Items: []
  - m_Id: 16691838979805184
    m_Localized: "Remove this piece and create one Jellu [Pawn] on its original square and one on an adjacent empty square. Both inherit its traits and receive [Attack Disabled] for 1 turn."
    m_Metadata:
      m_Items: []
  - m_Id: 16691838979805185
    m_Localized: Split cannot be used because it would exceed the maximum piece capacity.
    m_Metadata:
      m_Items: []
  - m_Id: 16691840000000001
    m_Localized: "Synthesis: Reinforce"
    m_Metadata:
      m_Items: []
  - m_Id: 16691840000000002
    m_Localized: "Absorb and remove one random adjacent allied [Pawn]. Gain [Breakthrough] and [Defence] for 1 turn each."
    m_Metadata:
      m_Items: []
  - m_Id: 16691840000000003
    m_Localized: "There is no adjacent allied [Pawn] to absorb."
    m_Metadata:
      m_Items: []
